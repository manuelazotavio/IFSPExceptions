generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SEDUC
  DIRETOR
  EXTERNO
}

model Escola {
  id        String   @id @default(cuid())
  nome      String
  bairro    String
  endereco  String
  latitude  Float
  longitude Float
  criadoEm  DateTime @default(now())

  usuarios    User[]
  ocorrencias Ocorrencia[]
  logs        LogAuditoria[]
}

model User {
  id       String   @id @default(cuid())
  nome     String
  email    String   @unique
  senha    String
  role     Role
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now())

  escolaId String?
  escola   Escola? @relation(fields: [escolaId], references: [id])
}

model Ocorrencia {
  id                 String    @id @default(cuid())
  protocolo          String    @unique
  titulo             String
  descricao          String    @db.Text
  tipo               String
  criticidade        String
  status             String    @default("Aberta")
  localizacaoInterna String
  endereco           String
  dataEnvio          DateTime
  dataAprovacao      DateTime?
  dataResolucao      DateTime?
  aprovadaPelaEscola Boolean   @default(true)
  criadoPorEmail     String
  criadoPorNome      String    @default("")
  chatPendente       Boolean   @default(false)
  fotos              String    @default("[]") @db.Text
  criadoEm           DateTime  @default(now())
  atualizadoEm       DateTime  @updatedAt

  escolaId String
  escola   Escola      @relation(fields: [escolaId], references: [id])
  interacoes Interacao[]
}

model Interacao {
  id       String   @id @default(cuid())
  origem   String
  autor    String
  mensagem String   @db.Text
  status   String?
  anexos   String   @default("[]") @db.Text
  criadoEm DateTime @default(now())

  ocorrenciaId String
  ocorrencia   Ocorrencia @relation(fields: [ocorrenciaId], references: [id], onDelete: Cascade)
}

model LogAuditoria {
  id           String   @id @default(cuid())
  acao         String
  entidade     String
  entidadeId   String?
  descricao    String   @db.Text
  usuarioEmail String?
  usuarioNome  String?
  criadoEm     DateTime @default(now())

  escolaId String?
  escola   Escola? @relation(fields: [escolaId], references: [id], onDelete: SetNull)
}
