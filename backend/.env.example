# String de conexão do MySQL usada pelo Prisma.
# Formato: mysql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
# Exemplo local: mysql://root:senha123@localhost:3306/zela
DATABASE_URL="mysql://usuario:senha@localhost:3306/zela"

# Porta em que a API Express vai escutar (opcional, padrão 3333).
PORT=3333

# Origem permitida pelo CORS — a URL onde o frontend (Vite) roda.
# Em desenvolvimento local o Vite sobe em http://localhost:5173.
FRONTEND_ORIGIN="http://localhost:5173"

# Segredo usado para assinar os tokens JWT de autenticação.
# Obrigatório — o servidor não sobe sem essa variável.
# Use uma string longa e aleatória 
JWT_SECRET="troque-por-um-segredo-aleatorio-e-forte"

# Tempo de expiração do token JWT (opcional, padrão "8h").
JWT_EXPIRES_IN="8h"
